# WeatherSense Backend Environment Variables

# Obtain your key from https://openweathermap.org/api
# Canonical variable name:
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional aliases supported:
# OPENWEATHERMAP_API_KEY=your_key
# OWM_API_KEY=your_key

# Secret key for admin routes (optional)
ADMIN_KEY=your_admin_secret_key_here
